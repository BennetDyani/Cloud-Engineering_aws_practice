# Terraform
# provider plugins downloaded by init (generated, large)
.terraform/         
# local state file that may contain secrets, maps your infrastructure to your configuration (sensitive, set by "terraform apply")
*.tfstate           
 # state backups: same risk
*.tfstate.*        
# saved plans can contain secret values
*.tfplan           
# variables file, may contain sensitive data
*.tfvars           
*.tfvars.json   
# "!" = eXEPTION: a safe template showing which variables existr
!example.tfvars     
# Terraform crash logs/dumps are usually very large and contain sensitive data
crash.log           
# local override of resources, for development only and not meant to be shared
override.tf         
override.tf.json    
*_override.tf        
# same as above, but with a name and in JSON format
*_override.tf.json  


# Secrets and Creditials
.env
.env.*
# "!" = eXEPTION: a safe template showing which variables exist
!.env.example        
# private key files/certifgicates
*.pem                
# access keys from AWS, GCP, etc. (sensitive)
*.key
*accessKeys*.csv     

# Generated app files 
# npm packages (generated, large)
node_modules/        
# build output (generated, large)
dist/                

# Machine / editor
Thumbs.db
desktop.ini
.vscode/

